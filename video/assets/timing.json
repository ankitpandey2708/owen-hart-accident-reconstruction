{
 "engine": "kokoro",
 "total": 71.375,
 "scenes": [
  {
   "id": "hook",
   "start": 0.0,
   "duration": 6.575,
   "voice": "assets/voice/hook.wav",
   "voice_start": 0.4,
   "voice_duration": 5.575,
   "text": "This is a snap shackle. Sailors use it to drop a line with one tug."
  },
  {
   "id": "who",
   "start": 6.575,
   "duration": 9.65,
   "voice": "assets/voice/who.wav",
   "voice_start": 6.975,
   "voice_duration": 8.65,
   "text": "On May 23rd, 1999, one of these was the only thing holding wrestler Owen Hart above the ring."
  },
  {
   "id": "plan",
   "start": 16.225,
   "duration": 7.675,
   "voice": "assets/voice/plan.wav",
   "voice_start": 16.625,
   "voice_duration": 6.675,
   "text": "The stunt: lower him from the rafters, then release just above the mat, as a comedy fall."
  },
  {
   "id": "release",
   "start": 23.9,
   "duration": 7.775,
   "voice": "assets/voice/release.wav",
   "voice_start": 24.3,
   "voice_duration": 2.875,
   "text": "Instead, near the roof, it opened."
  },
  {
   "id": "fall",
   "start": 31.675,
   "duration": 9.175,
   "voice": "assets/voice/fall.wav",
   "voice_start": 32.075,
   "voice_duration": 8.175,
   "text": "There was no backup line. He fell seventy-eight feet in about two seconds, reaching nearly fifty miles an hour."
  },
  {
   "id": "impact",
   "start": 40.85,
   "duration": 7.65,
   "voice": "assets/voice/impact.wav",
   "voice_start": 41.25,
   "voice_duration": 6.65,
   "text": "He hit the top rope chest first, a foot from the turnbuckle. The impact severed his aorta."
  },
  {
   "id": "after",
   "start": 48.5,
   "duration": 7.2,
   "voice": "assets/voice/after.wav",
   "voice_start": 48.9,
   "voice_duration": 6.2,
   "text": "He was pronounced dead at 8:12 PM. He was thirty-four. The show went on."
  },
  {
   "id": "fix",
   "start": 55.7,
   "duration": 8.675,
   "voice": "assets/voice/fix.wav",
   "voice_start": 56.1,
   "voice_duration": 7.675,
   "text": "A life-safety rig uses rated hardware, two independent lines, and no quick release on the load."
  },
  {
   "id": "end",
   "start": 64.375,
   "duration": 7.0,
   "voice": "assets/voice/end.wav",
   "voice_start": 64.775,
   "voice_duration": 3.6,
   "text": "No single part should ever hold a life alone."
  }
 ],
